# Copy to apps/web/.env. Values below match `npm run db:start` defaults:
# run `npx supabase status` to print the local keys.

# Supabase
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
# Server only. Never expose it to the browser or the widget.
NUXT_SUPABASE_SECRET_KEY=

# 'selfhost' (default) or 'saas' (enables billing and quotas)
NUXT_PUBLIC_EDITION=selfhost

# OAuth providers enabled in Supabase Auth (comma-separated): github,google
NUXT_PUBLIC_AUTH_PROVIDERS=

# Public URL of the app, used in embed snippets (defaults to the request origin)
NUXT_PUBLIC_APP_URL=

# Email: 'log' (prints to the console) or 'resend'
NUXT_MAIL_DRIVER=log
NUXT_MAIL_FROM="StaticDesk <notifications@staticdesk.app>"
NUXT_MAIL_RESEND_API_KEY=

# Public widget API
# Secret for daily visitor fingerprints (any long random string). Required in production.
NUXT_FINGERPRINT_SECRET=
# Read the client IP from X-Forwarded-For. Set to false if the app is exposed directly.
NUXT_TRUST_PROXY=true
# Cloudflare Turnstile (optional, per-site setting)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
