# Copy to apps/web/.env. Values below match `npm run db:start` defaults:
# run `npx supabase status` to print the local keys.

# Supabase
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
# Server only. Never expose it to the browser or the widget.
NUXT_SUPABASE_SECRET_KEY=

# 'selfhost' (default) or 'saas' (enables billing and quotas)
NUXT_PUBLIC_EDITION=selfhost

# OAuth providers enabled in Supabase Auth (comma-separated): github,google
NUXT_PUBLIC_AUTH_PROVIDERS=

# Public URL of the app, used in embed snippets (defaults to the request origin)
NUXT_PUBLIC_APP_URL=

# Server-side address of Supabase, when the server cannot reach the public URL
# (Docker). Leave empty otherwise.
NUXT_SUPABASE_INTERNAL_URL=

# Email: 'log' (prints to the console), 'resend' or 'smtp'
NUXT_MAIL_DRIVER=log
NUXT_MAIL_FROM="StaticDesk <notifications@staticdesk.app>"
NUXT_MAIL_RESEND_API_KEY=
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
# true for TLS from the start (port 465); otherwise STARTTLS when the server offers it
NUXT_MAIL_SMTP_SECURE=false
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASS=
# Shared inbox: visitor replies by email (Resend inbound). Leave empty to send
# replies with the team member's address as Reply-To instead.
NUXT_MAIL_INBOUND_DOMAIN=
# Signs reply+<thread>@ addresses (any long random string). Required with an inbound domain.
NUXT_MAIL_REPLY_SECRET=
# Signing secret of the Resend webhook pointing to /api/inbound/resend
# (events: email.received, email.bounced, email.complained)
NUXT_MAIL_RESEND_WEBHOOK_SECRET=

# Scheduled jobs (/api/cron/*, see shared/cron-jobs.ts). On Vercel, set CRON_SECRET
# to the same value. 'internal' runs them in this process (Docker, a single Node server).
NUXT_CRON_SECRET=
NUXT_SCHEDULER=

# Public widget API
# Secret for daily visitor fingerprints (any long random string). Required in production.
NUXT_FINGERPRINT_SECRET=
# Read the client IP from X-Forwarded-For. Set to false if the app is exposed directly.
NUXT_TRUST_PROXY=true
# Cloudflare Turnstile (optional, per-site setting)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
