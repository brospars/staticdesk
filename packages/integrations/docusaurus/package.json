{
  "name": "@staticdesk/docusaurus-plugin",
  "version": "0.0.0",
  "description": "Docusaurus plugin for StaticDesk: contact form and floating button on your docs",
  "license": "MIT",
  "homepage": "https://staticdesk.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brospars/staticdesk.git",
    "directory": "packages/integrations/docusaurus"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "contact-form",
    "feedback",
    "staticdesk"
  ],
  "type": "module",
  "files": [
    "lib"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
