{
  "name": "@staticdesk/widget",
  "version": "0.0.0",
  "description": "Embeddable contact forms, comments and reactions for static sites (StaticDesk)",
  "license": "MIT",
  "homepage": "https://staticdesk.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brospars/staticdesk.git",
    "directory": "packages/widget"
  },
  "keywords": [
    "contact-form",
    "comments",
    "widget",
    "static-site",
    "docusaurus",
    "mkdocs",
    "jekyll",
    "web-components"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/check-size.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@staticdesk/core": "*",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "./dist/widget.js",
  "unpkg": "./dist/widget.js",
  "jsdelivr": "./dist/widget.js",
  "exports": {
    ".": "./dist/widget.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
