{
  "name": "staticdesk",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/integrations/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --db-url 'postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable' --schema public > packages/core/src/database.types.ts",
    "db:test": "supabase test db",
    "release": "turbo run build --filter=@staticdesk/widget && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10"
  },
  "dependencies": {
    "h3": "^1.15.0"
  }
}
